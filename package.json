{
  "name": "arp",
  "private": true,
  "scripts": {
    "start": "cargo run --manifest-path gpui-ui/Cargo.toml --locked --",
    "demo": "cargo run --manifest-path gpui-ui/Cargo.toml --locked -- --demo",
    "test:python": "conda run -n sth_eb314 python -m unittest discover -v",
    "test:gpui": "cargo test --manifest-path gpui-ui/Cargo.toml --locked --no-default-features --lib",
    "test:realtime": "cargo test --manifest-path rust-realtime-core/Cargo.toml",
    "license:generate": "node scripts/generate-license.mjs",
    "test": "npm run test:python && npm run test:gpui && npm run test:realtime",
    "build": "cargo build --manifest-path gpui-ui/Cargo.toml --locked",
    "check": "npm run test && npm run build",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ./packaging/build_gpui_windows.ps1",
    "build:windows:full": "powershell -NoProfile -ExecutionPolicy Bypass -File ./packaging/build_full_windows.ps1"
  }
}
